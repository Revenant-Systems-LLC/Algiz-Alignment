<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Intrinsic-quality suite (brainstorm artifact, option B).
    Deliberately self-contained: no ProjectReference to Core/Proxy so it builds
    and runs even while feat/proxy-architecture is mid-refactor. The mechanism
    under test lives in Grounding.cs; the contract lives in IntrinsicSuite.cs.

    Red-by-default is intentional. See README.md in this folder for the map of
    which classes are expected RED (work remaining) vs GREEN (mechanism real).
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

</Project>
