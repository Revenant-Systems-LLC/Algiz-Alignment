<Window x:Class="SageRage.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAIGE-RAGE — Revenant Systems LLC"
        Height="900" Width="1440"
        MinHeight="720" MinWidth="1100"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>

  <!-- Root: full window black base -->
  <Border Background="#FF010101" x:Name="RootBorder">
    <Grid>

      <!-- Layer 0: Circuit background image (set in code-behind, random per nav) -->
      <Border x:Name="CircuitLayer"
              IsHitTestVisible="False" />

      <!-- Layer 1: 15% black overlay -->
      <Border Background="#26000000"
              IsHitTestVisible="False" />

      <!-- Layer 2: Shell -->
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="54" />   <!-- Title bar -->
          <RowDefinition Height="62" />   <!-- Nav bar -->
          <RowDefinition Height="*" />    <!-- Content -->
          <RowDefinition Height="28" />   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── TITLE BAR ── -->
        <Border Grid.Row="0"
                Background="#9E000000"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseDown">
          <Grid Margin="16,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Brand lockup -->
            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="0,0,16,0">
              <TextBlock Text="SAIGE-RAGE"
                         Style="{StaticResource Heading2}"
                         VerticalAlignment="Center"
                         FontSize="18" />
              <TextBlock Text="  ·  Revenant Systems LLC"
                         Style="{StaticResource LabelText}"
                         VerticalAlignment="Center"
                         Margin="8,0,0,0" />
            </StackPanel>

            <!-- Window controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        VerticalAlignment="Center">
              <Button x:Name="BtnMinimize" Content="—"
                      Width="40" Height="32"
                      Style="{StaticResource NavTab}"
                      Click="BtnMinimize_Click" />
              <Button x:Name="BtnMaximize" Content="□"
                      Width="40" Height="32"
                      Style="{StaticResource NavTab}"
                      Click="BtnMaximize_Click" />
              <Button x:Name="BtnClose" Content="✕"
                      Width="40" Height="32"
                      Style="{StaticResource NavTab}"
                      Click="BtnClose_Click" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- ── NAV BAR ── -->
        <Border Grid.Row="1"
                Background="#9E000000"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal"
                      VerticalAlignment="Center"
                      Margin="20,0">
            <Button x:Name="NavDashboard"
                    Content="DASHBOARD"
                    Style="{StaticResource NavTabActive}"
                    Click="Nav_Click" Tag="Dashboard" />
            <Button x:Name="NavProfiles"
                    Content="PROFILES"
                    Style="{StaticResource NavTab}"
                    Click="Nav_Click" Tag="Profiles" />
            <Button x:Name="NavTrace"
                    Content="TRACE LOG"
                    Style="{StaticResource NavTab}"
                    Click="Nav_Click" Tag="Trace" />
            <Button x:Name="NavProxy"
                    Content="PROXY"
                    Style="{StaticResource NavTab}"
                    Click="Nav_Click" Tag="Proxy" />
            <Button x:Name="NavSettings"
                    Content="SETTINGS"
                    Style="{StaticResource NavTab}"
                    Click="Nav_Click" Tag="Settings" />
          </StackPanel>
        </Border>

        <!-- ── CONTENT AREA ── -->
        <Frame Grid.Row="2"
               x:Name="ContentFrame"
               NavigationUIVisibility="Hidden"
               Background="Transparent" />

        <!-- ── STATUS BAR ── -->
        <Border Grid.Row="3"
                Background="#9E000000"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0">
          <Grid Margin="16,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Text="Ready."
                       Style="{StaticResource LabelText}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="VersionText"
                       Grid.Column="1"
                       Text="SAIGE-RAGE v0.1.0-alpha  ·  Revenant Systems LLC"
                       Style="{StaticResource LabelText}"
                       VerticalAlignment="Center" />
          </Grid>
        </Border>

      </Grid>
    </Grid>
  </Border>
</Window>
