###############################################################################
# SAGE-RAGE Environment Template (Python harness only)
#
# Copy this file to a `.env` next to where you run the Python harness
# (src/PythonHarness), or wherever python-dotenv will find it.
#
# The C# side (SageRage.Console, SageRage.Api, etc.) does not use this file —
# it stores keys via SecretLoader, which encrypts them with Windows DPAPI.
# Run the console app with --setup to configure C#-side keys.
#
# NEVER commit real keys to the repository.
# This file is a template only — all values are placeholders.
###############################################################################

### LLM Provider Keys ###

# Google Gemini  (used by: Gemini provider, Gemini Live Audio, Proxy -> Gemini)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI  (used by: OpenAI provider, Proxy -> OpenAI)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic / Claude  (used by: Anthropic provider)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# xAI / Grok  (used by: Proxy -> xAI)
XAI_API_KEY=your-xai-api-key-here

# OpenRouter  (used by: Proxy -> OpenRouter)
OPENROUTER_API_KEY=your-openrouter-api-key-here

### Optional / Auxiliary Keys ###

# Google API (general)
#GOOGLE_API_KEY=your-google-api-key-here

# GitHub Personal Access Token
#GIT_API_KEY=ghp_your-token-here

# Perplexity
#PERPLEXITY_API_KEY=your-perplexity-key-here

# Brave Search
#BRAVE_API_KEY=your-brave-key-here

# HuggingFace
#HFACE_API_KEY=hf_your-token-here
#HUGGINGFACE_API_KEY=hf_your-token-here

# NVIDIA NIM
#NVI_API_KEY=nvapi-your-key-here

# Ollama (if using authenticated remote)
#OLLAMA_API_KEY=your-ollama-key-here

# News API
#NEWS_API_KEY=your-newsapi-key-here
